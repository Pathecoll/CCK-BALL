#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    macros {
        ExposeUp: ExposeUp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp GLOBE>
            , <&macro_tap &kp UP_ARROW>
            , <&macro_release &kp GLOBE>;
            label = "EXPOSEUP";
        };

        ExposeDown: ExposeDown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp GLOBE>
            , <&macro_tap &kp DOWN>
            , <&macro_release &kp GLOBE>;
            label = "EXPOSEDOWN";
        };

        ExposeLeft: ExposeLeft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp GLOBE>
            , <&macro_tap &kp LEFT_ARROW>
            , <&macro_release &kp GLOBE>;
            label = "EXPOSELEFT";
        };

        ExposeRight: ExposeRight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp GLOBE>
            , <&macro_tap &kp RIGHT>
            , <&macro_release &kp GLOBE>;
            label = "EXPOSERIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC           &kp N1          &kp N2              &kp N3          &kp N4            &kp N5     &kp N6           &kp N7             &kp N8          &kp N9               &kp N0              &kp BACKSPACE
&kp ESCAPE        &kp Q           &kp W               &kp E           &kp R             &kp T      &kp Y            &kp U              &kp I           &kp O                &kp P               &kp BSLH
&kp TAB           &mt LEFT_ALT A  &mt LEFT_CONTROL S  &mt LEFT_GUI D  &mt LEFT_SHIFT F  &kp G      &kp H            &mt RIGHT_SHIFT J  &mt LEFT_GUI K  &mt RIGHT_CONTROL L  &mt RIGHT_ALT SEMI  &kp SQT
&kp LEFT_SHIFT    &lt 4 Z         &kp X               &kp C           &kp V             &kp B      &kp N            &kp M              &kp COMMA       &kp DOT              &lt 4 SLASH         &kp LEFT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_ALT    &kp LEFT_GUI        &kp DELETE      &kp SPACE         &lt 1 TAB  &lt 3 BACKSPACE  &kp SPACE          &kp ENTER       &kp RIGHT_GUI        &kp RIGHT_ALT       &kp RIGHT_CONTROL
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        Nav {
            bindings = <
&kp F12           &kp F1        &kp F2          &kp F3              &kp F4         &kp F5                &kp F6                 &kp F7        &kp F8        &kp F9         &kp F10        &kp F11
&trans            &trans        &kp PG_DN       &kp UP_ARROW        &kp PAGE_UP    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp N7        &kp N8        &kp N9         &trans         &trans
&trans            &trans        &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NUMBER_4  &kp N5        &kp NUMBER_6   &trans         &trans
&kp LEFT_SHIFT    &trans        &kp RC(LEFT)    &kp RC(UP_ARROW)    &kp RC(RIGHT)  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &trans         &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI    &kp RC(DOWN_ARROW)  &mo 2          &trans                &mo 4                  &kp N0        &kp DOT       &kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_vertical_encoder>;
        };

        NavIpad {
            bindings = <
&kp F12  &kp F1  &kp F2          &kp F3          &kp F4        &kp F5                &kp F6                 &kp F7        &kp F8        &kp F9        &kp F10  &kp F11
&trans   &trans  &kp PG_DN       &kp UP_ARROW    &kp PAGE_UP   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp N7        &kp N8        &kp N9        &trans   &trans
&trans   &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans   &trans
&trans   &trans  &ExposeLeft     &ExposeUp       &ExposeRight  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans   &trans
&trans   &trans  &trans          &ExposeDown     &trans        &trans                &trans                 &trans        &trans        &trans        &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Symbols {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2          &bt BT_SEL 3           &bt BT_SEL 4       &bt BT_CLR_ALL  &bt BT_CLR_ALL    &trans             &trans          &trans           &trans
&trans      &kp EXCL       &kp AT        &kp HASH              &kp DOLLAR             &kp PERCENT        &kp CARET       &kp AMPS          &kp ASTRK          &kp QUESTION    &kp APOS         &trans
&trans      &kp PLUS       &kp EQUAL     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp COLON       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
&trans      &kp LESS_THAN  &kp PIPE      &kp MINUS             &kp GREATER_THAN       &kp BACKSLASH      &kp GRAVE       &kp UNDER         &kp SLASH          &kp TILDE       &kp SEMI         &trans
&trans      &trans         &trans        &trans                &trans                 &mo 4              &trans          &trans            &trans             &trans          &trans           &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        ADJ {
            bindings = <
&trans  &trans  &trans          &bootloader  &sys_reset  &studio_unlock  &studio_unlock  &sys_reset  &bootloader  &trans     &trans  &trans
&trans  &trans  &trans          &trans       &trans      &trans          &trans          &trans      &trans       &trans     &trans  &trans
&trans  &trans  &kp C_PREVIOUS  &kp C_PLAY   &kp C_NEXT  &trans          &trans          &mkp LCLK   &mkp MCLK    &mkp RCLK  &trans  &trans
&trans  &trans  &trans          &kp C_MUTE   &trans      &trans          &trans          &trans      &trans       &mo 5      &trans  &trans
&trans  &trans  &trans          &mo 5        &trans      &trans          &trans          &trans      &trans       &trans     &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;

            // 编码器2：左右滚动
        };

        ADJ-Snipe {
            bindings = <
&trans  &trans  &trans          &bootloader  &sys_reset  &studio_unlock  &studio_unlock  &sys_reset  &bootloader  &trans     &trans  &trans
&trans  &trans  &trans          &trans       &trans      &trans          &trans          &trans      &trans       &trans     &trans  &trans
&trans  &trans  &kp C_PREVIOUS  &kp C_PLAY   &kp C_NEXT  &trans          &trans          &mkp LCLK   &mkp MCLK    &mkp RCLK  &trans  &trans
&trans  &trans  &trans          &trans       &trans      &trans          &trans          &trans      &trans       &trans     &trans  &trans
&trans  &trans  &trans          &trans       &trans      &trans          &trans          &trans      &trans       &trans     &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
